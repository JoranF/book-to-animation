# Password for the web app (HTTP basic auth, any username). Required.
APP_PASSWORD=
# Claude API key: writes the scripts. Set it in Dokploy (Environment tab),
# never commit it. Without it the app can only render ready-made scripts.
ANTHROPIC_API_KEY=
# ElevenLabs key for the voices (narrator, philosopher, youth). Without it the
# free built-in voice is used.
ELEVENLABS_API_KEY=
# Address of the Studio dashboard: shows a "Review and post in Studio" link.
# STUDIO_URL=https://studio.example.com
# Optional overrides
# DATA_DIR=/data
# SCRIPT_MODEL=claude-opus-5-5
# SCRIPT_EFFORT=high    # low | medium | high
# TTS_BACKEND=auto      # auto | elevenlabs | piper
# ELEVENLABS_VOICE_NARRATOR= / ELEVENLABS_VOICE_PHILOSOPHER= / ELEVENLABS_VOICE_YOUTH=  (voice ids)
# ELEVENLABS_MODEL=eleven_v4   # ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2   # ELEVENLABS_STABILITY=0.4
# PIPER_SPEAKER=8       # speaker of the free voice
# RENDER_WORKERS=2      # scenes rendered at the same time
# PRICE_LLM_IN_PER_MTOK=5 / PRICE_LLM_OUT_PER_MTOK=25 / PRICE_TTS_PER_1K_CHARS=0.20  (cost estimate only)

# --- The Studio app (studio/Dockerfile) has its own settings, not these: ---
# STUDIO_PASSWORD=          login of the dashboard
# POSTIZ_URL=               your Postiz server      POSTIZ_API_KEY=
# SOURCE_SHORTS_URL=        this app's address      SOURCE_SHORTS_PASSWORD=  (this app's APP_PASSWORD)
# SOURCE_CLIPS_URL=         the stream clipper      SOURCE_CLIPS_PASSWORD=   (its REVIEW_PASSWORD)
# Optional: POSTIZ_YOUTUBE_PRIVACY=public  POSTIZ_TIKTOK_METHOD=DIRECT_POST  POSTIZ_TIKTOK_AI_LABEL=1
