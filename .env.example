# Password for the web app (HTTP basic auth, any username). Required.
APP_PASSWORD=
# ElevenLabs key for the voices (narrator, philosopher, youth). Optional.
ELEVENLABS_API_KEY=
# fal key: needed for writing scripts (and as a second choice for the voice). Set it in
# Dokploy (Environment tab), never commit it. Without it the app can still
# render Shorts from a ready-made script with the free voice.
FAL_KEY=
# Optional overrides
# DATA_DIR=/data
# SCRIPT_MODEL=anthropic/claude-sonnet-4.5
# TTS_BACKEND=auto      # auto | elevenlabs | fal | piper
# ELEVENLABS_VOICE_NARRATOR= / ELEVENLABS_VOICE_PHILOSOPHER= / ELEVENLABS_VOICE_YOUTH=  (voice ids)
# TTS_VOICE=Brian       # ElevenLabs voice (fal)
# PIPER_SPEAKER=8       # speaker of the free voice
# RENDER_WORKERS=2      # scenes rendered at the same time
